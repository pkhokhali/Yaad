{
  "expo": {
    "name": "Yaad",
    "slug": "Yaad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yaad",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pkhokhali.yaad",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Yaad uses speech recognition so you can capture reminders by voice.",
        "NSMicrophoneUsageDescription": "Yaad needs the microphone to capture spoken reminders."
      }
    },
    "android": {
      "package": "com.pkhokhali.yaad",
      "adaptiveIcon": {
        "backgroundColor": "#F7F8FA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "RECORD_AUDIO",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F8FA"
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#C45C26"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Yaad needs the microphone to capture spoken reminders.",
          "speechRecognitionPermission": "Yaad uses speech recognition so you can capture reminders by voice."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
