  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:android": "expo prebuild --platform android",
    "build:apk": "powershell -ExecutionPolicy Bypass -File ./scripts/build-apk.ps1",
    "build:aab": "powershell -ExecutionPolicy Bypass -File ./scripts/build-aab.ps1",
    "credentials:sync": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-eas-credentials.ps1",
    "credentials:upload": "npm run credentials:sync && node ./scripts/upload-eas-keystore.cjs",
    "credentials:eas": "npm run credentials:upload",
    "build:eas": "npx eas-cli build --platform android --profile production --non-interactive",
    "clean:build": "powershell -ExecutionPolicy Bypass -File ./scripts/clean-build-caches.ps1",
    "build:apk:unix": "cd android && ./gradlew assembleRelease"
